{
  "_": [
    "Command lines that carry a credential, and the ones this rule cannot see.",
    "",
    "`kampr_fleet::secretish` and `dev.kampr.shared.model.secretish` both read this file, because",
    "the rule decides what a node writes to disk and what a client warns about, and two",
    "implementations that drifted would give the operator a warning that did not match what the",
    "node then did.",
    "",
    "`caught` names the word that triggered, so a message can say which one it was. `missed` is",
    "the honest half: shapes that DO carry a secret and are NOT caught, asserted so the blind",
    "spots are written down and tested rather than claimed. `clean` must never fire — a rule that",
    "cries wolf is one the operator learns to ignore.",
    "",
    "**Every case is asserted twice: as the argv written here, and as that argv joined into one",
    "string.** A fleet run is now a command line rather than an argv, and a book entry holds that",
    "line as its single argument, so the rule has to give the same answer to both shapes of the",
    "same command or the node and the client would disagree about the very same run."
  ],
  "caught": {
    "an inline assignment": { "args": ["TOKEN=hunter2", "./deploy"], "why": "TOKEN" },
    "a lowercase assignment": { "args": ["github_token=ghp_x", "./release"], "why": "github_token" },
    "an underscored api key": { "args": ["API_KEY=abc", "./sync"], "why": "API_KEY" },
    "a joined api key": { "args": ["APIKEY=abc", "./sync"], "why": "APIKEY" },
    "an aws secret": { "args": ["AWS_SECRET_ACCESS_KEY=abc", "aws", "s3", "ls"], "why": "AWS_SECRET_ACCESS_KEY" },
    "a long flag with a value": { "args": ["mysql", "--password=hunter2"], "why": "--password" },
    "a long flag before its value": { "args": ["mysql", "--password", "hunter2"], "why": "--password" },
    "a bearer flag": { "args": ["curl", "--oauth2-bearer", "eyJhbGci"], "why": "--oauth2-bearer" },
    "a passphrase": { "args": ["ssh-keygen", "-N", "--passphrase=letmein"], "why": "--passphrase" },
    "an assignment inside a shell line": { "args": ["sh", "-c", "TOKEN=abc ./deploy"], "why": "TOKEN" },
    "a bearer header": { "args": ["curl", "-H", "Authorization: Bearer eyJhbGciOi"], "why": "Authorization:" },
    "a bearer header inside a shell line": { "args": ["sh", "-c", "curl -H 'Authorization: Bearer x' https://h"], "why": "Authorization:" },
    "a credential flag": { "args": ["gh", "--credential=abc"], "why": "--credential" },
    "a token in a typed pipeline": { "args": ["TOKEN=abc ./deploy | tee log"], "why": "TOKEN" },
    "a password flag in a typed chain": { "args": ["./build && mysql --password=hunter2"], "why": "--password" },
    "a bearer header in a typed line": { "args": ["curl -H \"Authorization: Bearer eyJhbGciOi\" https://h | jq ."], "why": "Authorization:" }
  },
  "missed": {
    "a positional secret": ["./deploy", "hunter2"],
    "a secret with no name on it": ["psql", "postgres://dan:hunter2@db/app"],
    "a base64 blob": ["./enrol", "ZXlKaGJHY2lPaUpJVXpJMU5pSjkK"],
    "a flag this rule has never heard of": ["./deploy", "--unlock", "hunter2"],
    "a heredoc a shell line will read": ["sh", "-c", "./deploy < secrets.txt"],
    "a secret a typed line reads from a file": ["./deploy --unlock \"$(cat secrets.txt)\""]
  },
  "clean": {
    "an upgrade": ["pacman", "-Syu"],
    "the author of a commit": ["git", "log", "--author=dbrain"],
    "a sort key": ["sort", "-t=", "-k2"],
    "a key that is a keyboard": ["setxkbmap", "-option", "caps:escape"],
    "an assignment with nothing on the right": ["TOKEN=", "./deploy"],
    "an assignment of a variable the shell expands": ["sh", "-c", "TOKEN=$CI_TOKEN ./deploy"],
    "a header holding a variable the shell expands": ["sh", "-c", "curl -H \"Authorization: Bearer $TOKEN\" https://h"],
    "a flag naming a file rather than a secret": ["restic", "--password-file", "prod.pass", "backup"],
    "a flag naming a path rather than a secret": ["./deploy", "--credentials-path=/etc/creds"],
    "a port flag": ["ssh", "-p", "2222", "host"],
    "an author field": ["./release", "--author-name=dbrain"],
    "a public key path": ["ssh-copy-id", "-i", "id_ed25519.pub", "host"],
    "the fleet update": ["kampr", "update"],
    "a typed pipeline with nothing secret in it": ["find . -name \"*.rs\" | xargs wc -l"],
    "a typed chain that names a password file": ["restic --password-file prod.pass backup && echo done"]
  }
}
