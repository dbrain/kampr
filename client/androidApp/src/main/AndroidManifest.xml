<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- From targetSdk 37 a node on the phone's own subnet is unreachable without this, and the
         refusal is a silent connect() timeout rather than a permission error. Ignored below 37. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Scanning the desktop's pairing QR. An Android app link cannot do this job — a link names
         its hosts at build time and every operator's node is at a different one — so the camera is
         how a scanned code reaches the installed app. Asked for at the moment of scanning, and
         refusing it leaves the typed address and code working exactly as before. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application
        android:label="Kampr"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Kampr">
        <activity android:name=".MainActivity" android:exported="true"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- UnifiedPush: a distributor the user already runs delivers the same RFC 8291 payload
             the browser gets, so the node's sender is unchanged (docs/08-notifications.md). -->
        <service android:name=".KamprPushService" android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
