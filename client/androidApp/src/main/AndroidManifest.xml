<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- From targetSdk 37 a node on the phone's own subnet is unreachable without this, and the
         refusal is a silent connect() timeout rather than a permission error. Ignored below 37. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Scanning the desktop's pairing QR. An Android app link cannot do this job — a link names
         its hosts at build time and every operator's node is at a different one — so the camera is
         how a scanned code reaches the installed app. Asked for at the moment of scanning, and
         refusing it leaves the typed address and code working exactly as before. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application
        android:label="Kampr"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Kampr">
        <!--
             The app half of Digital Asset Links, and the reason passkeys are a browser feature
             here rather than an app one.

             Credential Manager checks the association in both directions before it will run a
             ceremony for a native app. The node serves the site half at
             `.well-known/assetlinks.json`, naming this package and this signing certificate, and
             `kampr doctor` proves Google reads it. The app half is this entry, and it names the
             node's hostname when the APK is compiled.

             A hostname baked into an APK is one an operator cannot hand to a stranger: every
             Kampr node is on a different one. So the shipped build declares nothing, and
             `Passkeys.android.kt` hides the passkey control on a build that does, because the
             ceremony it would start can only end in `RP ID cannot be validated`. Passkeys in the
             browser need none of this: a page's origin is its own RP ID, so anyone on
             `https://<their node>` can enrol one today.

             Building Kampr for one node you own: put its hostname in the string below, uncomment
             both, rebuild. The control comes back and the ceremony runs. docs/10-passkeys.md.

        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />
        -->
        <!-- `keyboard` alongside `keyboardHidden` because the pane screen draws its key row from
             the pair (HardKeyboard.android.kt): without it, attaching a keyboard is a *recreate*,
             which loses the pane's scrollback position to answer a question about the bottom bar. -->
        <activity android:name=".MainActivity" android:exported="true"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- UnifiedPush: a distributor the user already runs delivers the same RFC 8291 payload
             the browser gets, so the node's sender is unchanged (docs/08-notifications.md). -->
        <service android:name=".KamprPushService" android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
