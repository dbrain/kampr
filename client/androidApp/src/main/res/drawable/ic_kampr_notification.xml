<!-- Android discards colour on a notification icon, so this is one flat silhouette with the door
     knocked out rather than drawn. The sheep this replaced could not survive the reduction: at the
     24dp Android actually draws, its eyes were 1.6px and its muzzle 2.8px, so the knockouts filled
     in and it rendered as a blob 12x9px in the lower half of the badge.

     The ink box is 470x378 of the 512 viewport, centred — the 22dp keyline inside a 24dp canvas,
     which is what puts it at 22x18px at mdpi. Anything that moves the geometry has to hold that;
     it is not styling, it is the difference between a tent and a dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="512" android:viewportHeight="512"
    android:tint="#FFFFFF">
    <path android:fillColor="#FFFFFF" android:fillType="evenOdd"
        android:pathData="M256,67 C291,67 324,181 406,335 C432,393 461,445 492,445 L20,445
                          C51,445 80,393 106,335 C188,181 221,67 256,67 Z
                          M256,311 Q285,377 298,445 L214,445 Q227,377 256,311 Z" />
</vector>
